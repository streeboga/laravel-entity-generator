it('{{names}}: чужая запись — 404', function (): void {
    $foreign = {{model_class}}::factory()->create(['user_id' => $this->stranger->id]);

    $this->getJson('{{test_uri}}/'.$foreign->{{key_column}})->assertNotFound();
{{#update}}
    $this->patchJson('{{test_uri}}/'.$foreign->{{key_column}}, [])->assertNotFound();
{{/update}}
{{#destroy}}
    $this->deleteJson('{{test_uri}}/'.$foreign->{{key_column}})->assertNotFound();
{{/destroy}}
});
{{/show}}
{{/user}}
{{#show}}

it('{{names}}: своя запись читается', function (): void {
    $item = {{model_class}}::factory(){{#user}}->create(['user_id' => $this->owner->id]){{/user}}{{^user}}->create(){{/user}};

    $this->getJson('{{test_uri}}/'.$item->{{key_column}})->assertOk()->assertJsonPath('data.type', '{{resource_type}}');
});
{{/show}}
{{#destroy}}

it('{{names}}: удаляет запись', function (): void {
    $item = {{model_class}}::factory(){{#user}}->create(['user_id' => $this->owner->id]){{/user}}{{^user}}->create(){{/user}};

    $this->deleteJson('{{test_uri}}/'.$item->{{key_column}})->assertNoContent();
});
