use {{user_fqcn}};
use Illuminate\Auth\Access\Response;

/** {{Name}}: {{#user}}видит и меняет владелец, чужое — 404.{{/user}}{{^user}}TODO: ограничить доступ — сейчас пускает любого аутентифицированного.{{/user}} */
final class {{class}}
{
{{#index}}
    public function viewAny({{user_class}} $user): Response
    {
        return Response::allow();
    }
{{/index}}
{{#show}}

    public function view({{user_class}} $user, {{model_class}} $item): Response
    {
        return $this->owns($user, $item);
    }
{{/show}}
{{#store}}

    public function create({{user_class}} $user): Response
    {
        return Response::allow();
    }
{{/store}}
{{#update}}

    public function update({{user_class}} $user, {{model_class}} $item): Response
    {
        return $this->owns($user, $item);
    }
{{/update}}
{{#destroy}}

    public function delete({{user_class}} $user, {{model_class}} $item): Response
    {
        return $this->owns($user, $item);
    }
{{/destroy}}
{{#find}}

    private function owns({{user_class}} $user, {{model_class}} $item): Response
    {
{{#user}}
        return $item->user_id === $user->id ? Response::allow() : Response::denyAsNotFound();
{{/user}}
{{^user}}
        return Response::allow();
{{/user}}
    }
{{/find}}
}
